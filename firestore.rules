rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Capability links and calculation baselines are only accessible through authenticated APIs.
    match /preparer_handoffs/{id} { allow read, write: if false; }
    match /preparer_handoff_owners/{uid} { allow read, write: if false; }

    // Allow collection-group reads to any transactions doc, but only for the owner
    // This supports queries like collectionGroup('transactions') with where('user_id','==', uid)
    // Matching rules are ORed; each matching rule must enforce its own owner checks.
    match /{path=**}/transactions/{txId} {
      allow read: if request.auth != null
                  && (resource.data.get('user_id', '') == request.auth.uid
                      || resource.data.get('userId', '') == request.auth.uid);
      // Allow updates to specific user-editable fields for transactions in top-level or other collections
      // This is a fallback for transactions not under user_profiles/{uid}/accounts/{accountId}/transactions
      // Once the server has recorded a review (review_status), is_deductible changes
      // must go through the API so confirmed totals keep a server-stamped decision.
      // Historical-overlap fields (superseded_by, superseded_at, superseded_reason,
      // superseded_decision_id, overlap_reviewed*) are Admin SDK only: they are
      // outside this allow-list, so a client can neither add, change nor remove them.
      allow update: if request.auth != null
                    && (resource.data.get('user_id', '') == request.auth.uid
                        || resource.data.get('userId', '') == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'notes',
                         'user_classification_reason',
                         'receipt_url',
                         'receipt_filename',
                         'is_deductible',
                         'expense_type',
                         'deduction_score',
                         'deductible_reason',
                         'business_purpose',
                         'attendees',
                         'travel_destination',
                         'equipment_details',
                         'client_project',
                         'documentation_status',
                         'meeting_notes',
                         'mileage_details',
                         'updated_at'
                       ])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_deductible'])
                        || !resource.data.keys().hasAny(['review_status']));
      // Prevent creates/deletes from client (server-only)
      allow create, delete: if false;
    }

    // Durable profile refresh coordination is server-only.
    match /profile_analysis_refresh/{userId} {
      allow read, write: if false;
    }

    // ── Analysis Jobs ──────────────────────────────────────────────────────
    // For tracking analysis progress (new system).
    // Uses `get` for single-doc reads (may target a non-existent doc) and
    // `list` for queries (always has resource.data).
    match /analysis_jobs/{jobId} {
      // Existing jobs require an owner field written by the server. Preserve
      // subscriptions before creation only for the caller's exact UID prefix.
      allow get: if request.auth != null
                 && ((resource != null
                      && (resource.data.get('userId', '') == request.auth.uid
                          || resource.data.get('user_id', '') == request.auth.uid))
                     || (resource == null
                         && jobId.size() > request.auth.uid.size() + 1
                         && jobId[0:request.auth.uid.size() + 1] == request.auth.uid + '_'));
      allow list: if request.auth != null
                  && (resource.data.get('userId', '') == request.auth.uid
                      || resource.data.get('user_id', '') == request.auth.uid);
      allow write: if false; // only server updates this
    }

    // ── Analysis Status (legacy, for migration) ────────────────────────────
    match /analysis_status/{jobId} {
      allow get: if request.auth != null
                 && (resource.data.get('userId', '') == request.auth.uid
                     || resource.data.get('user_id', '') == request.auth.uid);
      allow list: if request.auth != null
                  && (resource.data.get('userId', '') == request.auth.uid
                      || resource.data.get('user_id', '') == request.auth.uid);
      allow write: if false; // clients never write; server uses Admin SDK
    }

    // ── User Corrections ───────────────────────────────────────────────────
    // Client-side corrections manager writes and reads these.
    match /user_corrections/{correctionId} {
      allow read: if request.auth != null
                  && resource.data.get('userId', '') == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.get('userId', '') == request.auth.uid;
      allow update, delete: if false; // corrections are immutable
    }

    // ── Learning Patterns ──────────────────────────────────────────────────
    // One document per user (keyed by userId). Read-only from client;
    // server (AI learning engine) writes via Admin SDK.
    match /learning_patterns/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      allow write: if false; // server-only via Admin SDK
    }

    // Bank tokens and cursors are encrypted/server-only. Admin SDK bypasses rules.
    match /plaid_connections/{itemId} {
      allow read, write: if false;
    }

    // Durable deletion gates and encrypted provider-recovery records are server-only.
    match /account_deletions/{uid} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Durable request throttling windows (lib/security/rate-limit.ts). IDs are
    // hashed; documents hold only counts. Server-only via the Admin SDK.
    match /rate_limits/{windowId} {
      allow read, write: if false;
    }

    // Scheduled-job progress markers (functions/src/index.ts cursor). Server-only via the Admin SDK.
    match /scheduled_jobs/{jobId} {
      allow read, write: if false;
    }

    // Support access audit trail (lib/support/access.ts). Server-only.
    match /support_audit/{entryId} {
      allow read, write: if false;
    }

    // ── User Profiles ──────────────────────────────────────────────────────
    // User profile can only be read by the owner, written via Admin/API only
    match /user_profiles/{uid} {
      // Server-calculated baselines cannot be supplied or edited by clients.
      match /assistant_tax_snapshots/{year} { allow read, write: if false; }
      allow read: if request.auth != null && request.auth.uid == uid
                  && (resource == null || !resource.data.keys().hasAny(['plaid_token', 'access_token']));

      // Allow the user to create their own profile doc if id === uid
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.id == uid
                    // Trial manager and Stripe webhook own these fields on create too.
                    // Sign-up acknowledgments are recorded only through the profile API.
                    && !request.resource.data.keys().hasAny([
                         'hasHistoricalAccess', 'subscriptionStatus', 'trialStart', 'trialEnd',
                         'subscriptionEnd', 'stripeCustomerId', 'stripeSubscriptionId',
                         'stripeSubscriptionStatus', 'subscriptionPlan',
                         'plaid_token', 'access_token', 'plaid_item_id', 'plaid_transactions_cursor',
                         'bankConnected', 'plaid_credentials_migrated', 'bank_reconnect_session_id',
                         'consents', 'consents_recorded_at'
                       ]);

      // Allow the user to update their own profile doc, but restrict subscription fields
      // Subscription fields can only be updated via Admin SDK (webhooks, API routes)
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    // Prevent clients from updating subscription-related fields
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                         'hasHistoricalAccess',
                         'subscriptionStatus', // App-managed subscription status
                         'trialStart', // App-managed trial start
                         'trialEnd', // App-managed trial end
                         'subscriptionEnd', // Stripe subscription period end
                         'stripeCustomerId',
                         'stripeSubscriptionId',
                         'stripeSubscriptionStatus', 'subscriptionPlan',
                         'plaid_token', 'access_token', 'plaid_item_id', 'plaid_transactions_cursor',
                         'bankConnected', 'plaid_credentials_migrated', 'bank_reconnect_session_id',
                         'consents', 'consents_recorded_at' // validated and stamped by /api/database/profiles
                       ]);

      // No client deletes
      allow delete: if false;

      // Meta subcollection (progress tracking, preferences, etc.)
      match /meta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Owner history review is available only through the authenticated, validated API.
      match /bank_reconnects/{sessionId}/{document=**} { allow read, write: if false; }

      // Accounts subcollection
      match /accounts/{accountId} {
        allow read: if request.auth != null && request.auth.uid == uid
                  && (resource == null || !resource.data.keys().hasAny(['plaid_token', 'access_token']));
        allow write: if false; // write via Admin/API only

        // Transactions
        match /transactions/{txId} {
          // Allow reading transactions
          allow read: if request.auth != null && request.auth.uid == uid
                  && (resource == null || !resource.data.keys().hasAny(['plaid_token', 'access_token']));

          // Allow user updates to transaction fields. Server-reviewed records
          // (review_status present) keep is_deductible server-owned; use the API.
          // Historical-overlap fields (superseded_by, superseded_at, superseded_reason,
          // superseded_decision_id, overlap_reviewed*) stay outside this allow-list:
          // only the operator command's Admin SDK writes ever set or clear them.
          allow update: if request.auth != null
                        && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'notes',
                             'user_classification_reason',
                             'receipt_url',
                             'receipt_filename',
                             'is_deductible',
                             'expense_type',
                             'deduction_score',
                             'deductible_reason',
                             'business_purpose',
                             'attendees',
                             'travel_destination',
                             'equipment_details',
                             'client_project',
                             'documentation_status',
                             'meeting_notes',
                             'mileage_details',
                             'updated_at'
                           ])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_deductible'])
                            || !resource.data.keys().hasAny(['review_status']));

          // Prevent arbitrary creates/deletes from client
          // Server-side analysis updates use Admin SDK (bypasses these rules)
          allow create, delete: if false;
        }
      }
    }
  }
}
