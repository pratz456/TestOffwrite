rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Receipt files: receipts/{userId}/{transactionId}/{filename}
    match /receipts/{userId}/{transactionId}/{filename} {
      // Receipt bytes are private server data. Upload, download and deletion go through
      // authenticated API routes that verify email, transaction ownership, byte signatures,
      // size and MIME type. The Admin SDK bypasses these client rules.
      allow read, write, delete: if false;
    }
    
    // Deny all other paths
    match /{allPaths=**} {
      allow read, write, delete: if false;
    }
  }
}
