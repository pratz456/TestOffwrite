rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // An expiring capability is validated on the server before streaming a snapshot.
    match /preparer_handoffs/{uid}/{allPaths=**} { allow read, write: if false; }
    // Receipt files: receipts/{userId}/{transactionId}/{filename}
    match /receipts/{userId}/{transactionId}/{filename} {
      // Users can only access their own receipts
      allow read: if request.auth != null && request.auth.uid == userId;
      // Validate both new uploads and replacements; deletes have no request.resource.
      allow create, update: if request.auth != null && request.auth.uid == userId
                            && request.resource.size > 0
                            && request.resource.size <= 10 * 1024 * 1024
                            && request.resource.contentType in [
                              'image/jpeg', 'image/jpg', 'image/png', 'image/gif',
                              'image/webp', 'application/pdf'
                            ];
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deny all other paths
    match /{allPaths=**} {
      allow read, write, delete: if false;
    }
  }
}
