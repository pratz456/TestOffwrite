# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/\.next/cache/
/\.turbo/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.bak
*.tmp
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
#.env.local
#.env
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backup directories
api-backup/

# Firebase local/deploy artifacts
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Firebase Functions (if present)
functions/node_modules/
functions/.next/
functions/.cache/

# IDE/editor
.vscode/
.idea/

# Archives and upload bundles
upload_bundles/
*.zip

# Package managers & stores
.pnpm-store/
.npm/

# General logs
*.log

# Test scripts (may contain sensitive data)
scripts/test-plaid-transactions.js
scripts/test-force-1year.js
scripts/test-full-history.js
scripts/test-reconnect-max-transactions.js
scripts/.reconnect-test-results.json